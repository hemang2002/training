# ---------------------------------------------------------------------------
# ANTI-EXAMPLE - the "first attempt" Dockerfile most people write.
# Build it ONLY to compare image size / build time with api/Dockerfile:
#     docker build -f api/Dockerfile.naive -t cifar-api:naive .
#     docker images | grep cifar-api
#
# What's wrong with it (discuss with students):
#   1. Full python image (~1 GB) instead of python:*-slim (~130 MB)
#   2. Installs torch + torchvision although the API only needs onnxruntime  (+ ~1-2.5 GB)
#   3. COPY . . BEFORE pip install -> any code change invalidates the pip layer (slow rebuilds)
#   4. Leaves pip cache in the image
#   5. Runs as root
#   6. Uses the Flask development server (python app.py) instead of gunicorn
#   7. No HEALTHCHECK, no pinned base image tag
# ---------------------------------------------------------------------------
FROM python:3.12
WORKDIR /app
COPY . .
RUN pip install torch torchvision flask onnxruntime numpy pillow
ENV MODEL_DIR=/app/models
EXPOSE 5000
CMD ["python", "api/app.py"]
